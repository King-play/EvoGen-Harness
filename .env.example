# OpenAI-compatible fixed LLM used by formal policy extraction and TRACE.
GENHARNESS_LLM_BASE_URL=https://api.example.com/v1
GENHARNESS_LLM_MODEL=gpt-4.1
GENHARNESS_LLM_MODEL_SNAPSHOT=gpt-4.1-2025-04-14
GENHARNESS_LLM_API_KEY=replace-with-a-secret-from-your-secret-store

# Generic HTTP generation/search/inspection adapter credential.
# GEN_HARNESS_API_KEY=replace-with-a-secret-from-your-secret-store

# Local generation and internal verification model locations.
# GENHARNESS_PYTHON=/absolute/path/to/the/runtime/python
# GENHARNESS_FLUX_MODEL_ROOT=/absolute/path/to/FLUX.1-dev
# GENHARNESS_FLOW_GRPO_MODEL_ROOT=/absolute/path/to/sd3.5-flow-grpo-root
# GENHARNESS_T2ICOMPBENCHPP_RUN_ROOT=/absolute/path/to/run/cache/root
# GENHARNESS_FLUX_ENDPOINT=http://127.0.0.1:9001/generate
# GENHARNESS_QWEN_IMAGE_ENDPOINT=http://127.0.0.1:9002/generate
# GENHARNESS_JANUS_PRO_ENDPOINT=http://127.0.0.1:9003/generate
# GENHARNESS_OWLV2_MODEL=/absolute/path/to/owlv2-base-patch16-ensemble
# GENHARNESS_NVILA_MODEL=/absolute/path/to/NVILA-Lite-2B-Verifier

# Post-generation official evaluator locations. These are deliberately
# explicit: release scripts never assume adjacent private checkouts.
# GENHARNESS_GENEVAL2_OFFICIAL_REPO=/absolute/path/to/pinned/GenEval2
# GENHARNESS_GENEVAL2_EVAL_MODEL=/absolute/path/to/Qwen3-VL-8B-Instruct
# GENHARNESS_T2ICOMPBENCHPP_OFFICIAL_REPO=/absolute/path/to/pinned/T2I-CompBench-plus
# GENHARNESS_T2ICOMPBENCHPP_ASSET_DIR=/absolute/path/to/T2I-CompBench-plus/evaluator-assets
# GENHARNESS_WISE_OFFICIAL_REPO=/absolute/path/to/pinned/WISE-or-WiScore
# GENHARNESS_WISE_EVAL_MODEL=/absolute/path/to/WISE-evaluator-model
